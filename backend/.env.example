# Supported: gemini, openai, anthropic, azure-openai, ollama, vllm, lm-studio,
# or any provider exposing an OpenAI-compatible /chat/completions endpoint.
CUSTOMS_AI_PROVIDER=
CUSTOMS_AI_API_KEY=
CUSTOMS_AI_MODEL=
CUSTOMS_AI_BASE_URL=
CUSTOMS_AI_TIMEOUT_SECONDS=60

# For Anthropic, optionally override the API version.
CUSTOMS_AI_ANTHROPIC_VERSION=
